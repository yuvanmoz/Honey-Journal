{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for Honey Journal",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-read",
      "allow": [
        { "path": "**" },
        { "path": "/storage/emulated/0/**" },
        { "path": "/storage/emulated/0/HoneyJournal/**" }
      ]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [
        { "path": "**" },
        { "path": "/storage/emulated/0/**" },
        { "path": "/storage/emulated/0/HoneyJournal/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "**" },
        { "path": "/storage/emulated/0/**" },
        { "path": "/storage/emulated/0/HoneyJournal/**" }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "**" },
        { "path": "/storage/emulated/0/**" },
        { "path": "/storage/emulated/0/HoneyJournal/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "**" },
        { "path": "/storage/emulated/0/**" },
        { "path": "/storage/emulated/0/HoneyJournal/**" }
      ]
    }
  ]
}
